[Unit]
Description=BOILCLOUD auto-buyer (woken by fac-tg-watch and the boilcloud_sale provider)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/projects/vps-stock-watch/vps-stock-watch
EnvironmentFile=/root/projects/vps-stock-watch/vps-stock-watch/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/projects/vps-stock-watch/vps-stock-watch/.playwright-browsers
# Plain HTTP for every page; since 2026-11-27 cart.php sits behind a Cloudflare
# challenge, so a plain Chromium on a virtual display opens it now and then to
# renew cf_clearance (watcher.boil_autobuy.refresh_clearance).
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24" /root/projects/vps-stock-watch/vps-stock-watch/.venv/bin/python -m watcher.boil_autobuy --config /root/projects/vps-stock-watch/vps-stock-watch/config.yaml
Restart=on-failure
RestartSec=1min
# Chromium peaks ~700 MB while renewing the clearance (708 MB seen 2026-11-28
# on an 8 GB host, where swap no longer squeezes it).
MemoryMax=1200M
KillMode=mixed
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
